generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
  RETURNED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  CASH_ON_DELIVERY
  WAVE
  ORANGE_MONEY
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum StockMovementType {
  INITIAL
  ADJUSTMENT
  DISPATCH
  RETURN
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  slug        String           @unique
  description String           @default("")
  isDemo      Boolean          @default(false)
  status      ProductStatus    @default(DRAFT)
  archivedAt  DateTime?        @db.Timestamptz(3)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId, status])
}

model ProductVariant {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku        String          @unique
  label      String
  attributes Json            @default("{}")
  priceXof   Int
  active     Boolean         @default(true)
  inventory  Inventory?
  images     ProductImage[]
  movements  StockMovement[]
  orderItems OrderItem[]
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([id, productId])
  @@index([productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  objectKey String
  alt       String
  position  Int             @default(0)

  @@index([productId, position])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  version   Int            @default(0)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
}

model StockReservation {
  id          String            @id @default(cuid())
  orderItemId String            @unique
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, expiresAt])
}

model StockMovement {
  id           String            @id @default(cuid())
  variantId    String
  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderItemId  String?
  orderItem    OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  type         StockMovementType
  quantity     Int
  reason       String
  actorId      String?
  actor        User?             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  operationKey String            @unique
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([variantId, createdAt])
}

model Customer {
  id              String            @id @default(cuid())
  name            String
  phoneNormalized String
  addresses       CustomerAddress[]
  orders          Order[]
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([phoneNormalized])
}

model CustomerAddress {
  id           String        @id @default(cuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  zoneId       String?
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  district     String
  address      String
  instructions String?

  @@index([customerId])
}

model Order {
  id              String               @id @default(cuid())
  isDemo          Boolean              @default(false)
  customerId      String
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reference       String               @unique
  status          OrderStatus          @default(PENDING_CONFIRMATION)
  currency        String               @default("XOF") @db.Char(3)
  subtotalXof     Int
  deliveryXof     Int
  totalXof        Int
  addressSnapshot Json
  contactSnapshot Json
  idempotencyKey  String               @unique
  requestHash     String
  accessTokenHash String               @unique
  version         Int                  @default(0)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  shipment        Shipment?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId          String
  variant            ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  nameSnapshot       String
  skuSnapshot        String
  attributesSnapshot Json
  unitPriceXof       Int
  quantity           Int
  lineTotalXof       Int
  reservation        StockReservation?
  movements          StockMovement[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason     String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amountXof         Int
  currency          String          @default("XOF") @db.Char(3)
  providerReference String?
  idempotencyKey    String          @unique
  failureCode       String?
  events            PaymentEvent[]
  refunds           Refund[]
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerReference])
  @@index([orderId, status])
}

model PaymentEvent {
  id               String                @id @default(cuid())
  paymentId        String?
  payment          Payment?              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  providerEventId  String
  type             String
  processingStatus EventProcessingStatus @default(RECEIVED)
  receivedAt       DateTime              @default(now()) @db.Timestamptz(3)
  processedAt      DateTime?             @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([processingStatus, receivedAt])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountXof         Int
  status            RefundStatus @default(PENDING)
  externalReference String?
  operationKey      String       @unique
  actorId           String
  actor             User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason            String
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
}

model DeliveryZone {
  id        String            @id @default(cuid())
  isDemo    Boolean           @default(false)
  name      String            @unique
  feeXof    Int
  active    Boolean           @default(true)
  addresses CustomerAddress[]
  shipments Shipment[]
}

model Shipment {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  zoneId              String
  zone                DeliveryZone   @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  status              ShipmentStatus @default(PENDING)
  deliveryFeeSnapshot Int
  addressSnapshot     Json
  dispatchedAt        DateTime?      @db.Timestamptz(3)
  deliveredAt         DateTime?      @db.Timestamptz(3)

  @@index([zoneId])
}

model Role {
  id    String @id
  users User[]
}

// Better Auth owns session/account credential formats; do not implement custom crypto.
model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  emailVerified  Boolean              @default(false)
  image          String?
  roleId         String               @default("MANAGER")
  role           Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  sessions       Session[]
  accounts       Account[]
  stockMovements StockMovement[]
  orderHistory   OrderStatusHistory[]
  refunds        Refund[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model StoreSettings {
  id          String   @id @default("store")
  name        String
  contacts    Json     @default("{}")
  socialLinks Json     @default("{}")
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action       String
  targetType   String
  targetId     String
  safeDiff     Json
  operationKey String   @unique
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
