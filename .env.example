# Copy to .env; generate your own random secret (32+ characters).
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://msd:CHANGE_ME@127.0.0.1:55432/msd_dev
DIRECT_URL=postgresql://msd:CHANGE_ME@127.0.0.1:55432/msd_dev
BETTER_AUTH_SECRET=
# Electronic payments are not implemented in Phase 2.
PAYMENT_MODE=disabled
CHECKOUT_MODE=disabled
SEO_INDEXING=disabled
PRODUCT_IMAGE_STORAGE=local
# Preview deployment: PRODUCT_IMAGE_STORAGE=vercel-blob, private store only.
# Vercel connected store provides BLOB_STORE_ID (OIDC); local migration can use a secret token.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Set CHECKOUT_MODE=demo only on an isolated demonstration database.
# Dedicated disposable DB, never the application/production database.
TEST_DATABASE_URL=postgresql://msd:CHANGE_ME@127.0.0.1:55432/msd_test
